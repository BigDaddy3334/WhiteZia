+    /// Send an IPv4 ICMP port-unreachable for a locally unsupported UDP flow.
+    /// Quotes the original IP/UDP tuple so the kernel can notify the right socket.
+    pub fn reject_port_unreachable(&self) -> std::io::Result<()> {
+        let (std::net::SocketAddr::V4(src), std::net::SocketAddr::V4(dst)) = (self.src_addr, self.dst_addr) else {
+            return Err(std::io::ErrorKind::Unsupported.into());
+        };
+        let payload = self.first_payload.as_deref().unwrap_or_default();
+        let original_ip = Ipv4Header::new((8 + payload.len()) as u16, TTL, IpNumber::UDP, src.ip().octets(), dst.ip().octets())
+            .map_err(IpStackError::from)?;
+        let original_udp = UdpHeader::with_ipv4_checksum(src.port(), dst.port(), &original_ip, payload)
+            .map_err(IpStackError::from)?;
+        let mut icmp = vec![3_u8, 3, 0, 0, 0, 0, 0, 0];
+        original_ip.write(&mut icmp)?;
+        original_udp.write(&mut icmp)?;
+        icmp.extend_from_slice(&payload[..payload.len().min(8)]);
+        let mut sum = 0_u32;
+        for word in icmp.chunks(2) {
+            sum += u16::from_be_bytes([word[0], *word.get(1).unwrap_or(&0)]) as u32;
+        }
+        while sum >> 16 != 0 { sum = (sum & 0xffff) + (sum >> 16); }
+        icmp[2..4].copy_from_slice(&(!(sum as u16)).to_be_bytes());
+        let ip = Ipv4Header::new(icmp.len() as u16, TTL, IpNumber::ICMP, dst.ip().octets(), src.ip().octets())
+            .map_err(IpStackError::from)?;
+        self.up_pkt_sender.send(NetworkPacket {
+            ip: IpHeader::Ipv4(ip), transport: TransportHeader::Unknown, payload: Some(icmp),
+        }).map_err(|_| std::io::ErrorKind::BrokenPipe.into())
+    }
+
     fn reset_timeout(&mut self) {
         let deadline = tokio::time::Instant::now() + self.timeout_interval;
         self.timeout.as_mut().reset(deadline);
@@ -258,4 +286,28 @@ mod tests {
