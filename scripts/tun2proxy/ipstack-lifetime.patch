+    #[tokio::test]
+    async fn reject_udp_quotes_tuple_and_has_valid_ipv4_and_icmp_checksums() {
+        let (up_tx, mut up_rx) = mpsc::unbounded_channel();
+        let udp = IpStackUdpStream::new("172.19.0.1:45678".parse().unwrap(), "198.18.0.7:443".parse().unwrap(),
+            vec![1, 2, 3, 4, 5, 6, 7, 8, 9], up_tx, 1500, Duration::from_secs(10), None);
+        udp.reject_port_unreachable().unwrap();
+        let packet = up_rx.try_recv().unwrap();
+        let bytes = packet.to_bytes().unwrap();
+        assert_eq!(bytes[9], 1); // IPv4 ICMP
+        assert_eq!(&bytes[12..16], &[198, 18, 0, 7]);
+        assert_eq!(&bytes[16..20], &[172, 19, 0, 1]);
+        assert_eq!(&bytes[20..22], &[3, 3]);
+        assert_eq!(&bytes[44..48], &[198, 18, 0, 7]);
+        assert_eq!(&bytes[48..50], &45678_u16.to_be_bytes());
+        assert_eq!(&bytes[50..52], &443_u16.to_be_bytes());
+        assert_eq!(&bytes[56..64], &[1, 2, 3, 4, 5, 6, 7, 8]);
+        for data in [&bytes[..20], &bytes[20..]] {
+            let mut sum = 0_u32;
+            for pair in data.chunks(2) { sum += u16::from_be_bytes([pair[0], *pair.get(1).unwrap_or(&0)]) as u32; }
+            while sum >> 16 != 0 { sum = (sum & 0xffff) + (sum >> 16); }
+            assert_eq!(sum as u16, 0xffff);
+        }
+    }
