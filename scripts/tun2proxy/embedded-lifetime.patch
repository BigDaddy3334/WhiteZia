+#[cfg(test)]
+mod whitezia_tests {
+    use super::*;
+    use hickory_proto::{op::{Message, Query, ResponseCode}, rr::{Name, RecordType}};
+    use std::str::FromStr;
+
+    fn dns() -> VirtualDns { VirtualDns::new(IpCidr::from_str("198.18.0.0/15").unwrap()) }
+    fn query(kind: RecordType) -> Vec<u8> {
+        let mut query = Message::new(5173, hickory_proto::op::MessageType::Query, hickory_proto::op::OpCode::Query);
+        query.add_query(Query::query(Name::from_str("cached.example").unwrap(), kind));
+        query.to_vec().unwrap()
+    }
+    #[test]
+    fn issued_address_survives_unrelated_dns_and_browser_parallelism() {
+        let mut dns = dns();
+        let cached = dns.find_or_allocate_ip("cached.example".into()).unwrap();
+        for i in 0..4096 { dns.find_or_allocate_ip(format!("parallel-{i}.example")).unwrap(); }
+        assert_eq!(dns.resolve_ip(&cached).map(String::as_str), Some("cached.example"));
+        assert_eq!(dns.find_or_allocate_ip("cached.example.".into()).unwrap(), cached);
+    }
+    #[test]
+    fn capacity_refuses_new_names_without_reusing_issued_addresses() {
+        let mut dns = dns();
+        let cached = dns.find_or_allocate_ip("cached.example".into()).unwrap();
+        for i in 1..MAX_MAPPINGS { dns.find_or_allocate_ip(format!("name-{i}.example")).unwrap(); }
+        assert!(dns.find_or_allocate_ip("overflow.example".into()).is_err());
+        assert_eq!(dns.resolve_ip(&cached).map(String::as_str), Some("cached.example"));
+        assert_eq!(dns.lru_cache.len(), MAX_MAPPINGS);
+    }
+    #[test]
+    fn only_a_queries_allocate_ipv4_mappings() {
+        let mut dns = dns();
+        for kind in [RecordType::AAAA, RecordType::HTTPS, RecordType::SVCB] {
+            let (reply, _, ip) = dns.generate_query(&query(kind)).unwrap();
+            let reply = Message::from_vec(&reply).unwrap();
+            assert_eq!(reply.metadata.response_code, ResponseCode::NoError);
+            assert!(reply.answers.is_empty());
+            assert!(ip.is_none());
+        }
+        assert_eq!(dns.lru_cache.len(), 0);
+        let (reply, _, ip) = dns.generate_query(&query(RecordType::A)).unwrap();
+        let reply = Message::from_vec(&reply).unwrap();
+        assert!(ip.is_some());
+        assert_eq!(reply.answers[0].record_type(), RecordType::A);
+        assert_eq!(reply.answers[0].ttl, 5);
+    }
+    #[test]
+    #[ignore = "wall-clock regression; run explicitly for release validation"]
+    fn issued_address_survives_more_than_old_sixty_second_timeout() {
+        let mut dns = dns();
+        let cached = dns.find_or_allocate_ip("cached.example".into()).unwrap();
+        std::thread::sleep(std::time::Duration::from_secs(61));
+        dns.find_or_allocate_ip("unrelated.example".into()).unwrap();
+        assert_eq!(dns.resolve_ip(&cached).map(String::as_str), Some("cached.example"));
+    }
+
+}
