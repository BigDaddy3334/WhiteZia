diff --git a/internal/client/cottenmax_admission.go b/internal/client/cottenmax_admission.go
new file mode 100644
index 0000000..750512e
--- /dev/null
+++ b/internal/client/cottenmax_admission.go
@@ -0,0 +1,144 @@
+package client
+
+// WhiteZia modification, 2026-10-23: bounded local Max admission only.
+// Normal and the authenticated Max wire protocol/cryptography are unchanged.
+
+import (
+	"container/list"
+	"context"
+	"errors"
+	"net"
+	"sync"
+	"time"
+)
+
+const cottenMaxLocalActiveLimit = 24
+const cottenMaxLocalPendingLimit = 64
+
+var errCottenMaxQueueFull = errors.New("cottenmax: local stream queue is full")
+
+type cottenMaxWaiter struct {
+	ctx     context.Context
+	ready   chan struct{}
+	element *list.Element
+	granted bool
+}
+
+// An idle admitted stream retains its slot until its owner closes it. Admission
+// never kills a live application flow to make room for another one. Queue and
+// dial share the caller's one deadline; cancellation removes the waiter.
+type cottenMaxAdmission struct {
+	mu           sync.Mutex
+	active       int
+	limit        int
+	pendingLimit int
+	pending      list.List
+}
+
+func newCottenMaxAdmission(limit int) *cottenMaxAdmission {
+	if limit <= 0 || limit > cottenMaxLocalActiveLimit {
+		limit = cottenMaxLocalActiveLimit
+	}
+	return &cottenMaxAdmission{limit: limit, pendingLimit: cottenMaxLocalPendingLimit}
+}
+
+func newCottenMaxAdmissions(configured int) (*cottenMaxAdmission, *cottenMaxAdmission, int) {
+	total := configured
+	if total <= 0 || total > 28 {
+		total = 28
+	}
+	if total == 1 {
+		shared := newCottenMaxAdmission(1)
+		return shared, shared, total
+	}
+	reserved := min(4, total/2)
+	regular := newCottenMaxAdmission(total - reserved)
+	health := newCottenMaxAdmission(reserved)
+	health.pendingLimit = 8
+	return regular, health, total
+}
+
+func (g *cottenMaxAdmission) acquire(ctx context.Context) (func(), bool, error) {
+	return g.acquireWatching(ctx, nil)
+}
+
+func (g *cottenMaxAdmission) acquireWatching(ctx context.Context, peerClosed func() bool) (func(), bool, error) {
+	g.mu.Lock()
+	if err := ctx.Err(); err != nil {
+		g.mu.Unlock()
+		return nil, false, err
+	}
+	if g.active < g.limit && g.pending.Len() == 0 {
+		g.active++
+		g.mu.Unlock()
+		return g.releaseOnce(), false, nil
+	}
+	if g.pending.Len() >= g.pendingLimit {
+		g.mu.Unlock()
+		return nil, false, errCottenMaxQueueFull
+	}
+	w := &cottenMaxWaiter{ctx: ctx, ready: make(chan struct{})}
+	w.element = g.pending.PushBack(w)
+	g.mu.Unlock()
+	var tick <-chan time.Time
+	if peerClosed != nil {
+		ticker := time.NewTicker(100 * time.Millisecond)
+		defer ticker.Stop()
+		tick = ticker.C
+	}
+	remove := func(err error) (func(), bool, error) {
+		g.mu.Lock()
+		if w.element != nil {
+			g.pending.Remove(w.element)
+			w.element = nil
+		} else if w.granted {
+			g.releaseLocked()
+		}
+		g.mu.Unlock()
+		return nil, true, err
+	}
+	for {
+		select {
+		case <-w.ready:
+			release := g.releaseOnce()
+			if err := ctx.Err(); err != nil {
+				release()
+				return nil, true, err
+			}
+			return release, true, nil
+		case <-ctx.Done():
+			return remove(ctx.Err())
+		case <-tick:
+			if peerClosed() {
+				return remove(net.ErrClosed)
+			}
+		}
+	}
+}
+
+func (g *cottenMaxAdmission) releaseOnce() func() {
+	var once sync.Once
+	return func() { once.Do(func() { g.mu.Lock(); defer g.mu.Unlock(); g.releaseLocked() }) }
+}
+
+func (g *cottenMaxAdmission) releaseLocked() {
+	g.active--
+	for element := g.pending.Front(); element != nil; element = g.pending.Front() {
+		w := element.Value.(*cottenMaxWaiter)
+		g.pending.Remove(element)
+		w.element = nil
+		if w.ctx.Err() != nil {
+			continue
+		}
+		w.granted = true
+		g.active++
+		close(w.ready)
+		break
+	}
+}
+
+func (g *cottenMaxAdmission) state() (int, int) {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.active, g.pending.Len()
+}
