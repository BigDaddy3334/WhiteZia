@@ -0,0 +1,274 @@
+package client
+
+import (
+	"context"
+	"errors"
+	"net"
+	"runtime"
+	"sync"
+	"testing"
+	"time"
+)
+
+func waitMaxAdmission(t *testing.T, g *cottenMaxAdmission, active, pending int) {
+	t.Helper()
+	deadline := time.Now().Add(time.Second)
+	for time.Now().Before(deadline) {
+		a, p := g.state()
+		if a == active && p == pending {
+			return
+		}
+		time.Sleep(time.Millisecond)
+	}
+	a, p := g.state()
+	t.Fatalf("admission state active=%d pending=%d expected %d/%d", a, p, active, pending)
+}
+
+func TestWhiteZiaMaxAdmissionFIFOAndExactlyOnceRelease(t *testing.T) {
+	g := newCottenMaxAdmission(1)
+	release, queued, err := g.acquire(context.Background())
+	if err != nil || queued {
+		t.Fatal("first slot not immediate")
+	}
+	order := make(chan int, 2)
+	releaseWaiters := make(chan struct{})
+	var wg sync.WaitGroup
+	for i := 0; i < 2; i++ {
+		wg.Add(1)
+		go func(id int) {
+			defer wg.Done()
+			done, q, e := g.acquire(context.Background())
+			if e != nil || !q {
+				t.Errorf("pending acquisition: %v", e)
+				return
+			}
+			order <- id
+			<-releaseWaiters
+			done()
+			done()
+		}(i)
+		waitMaxAdmission(t, g, 1, i+1)
+	}
+	release()
+	release()
+	if got := <-order; got != 0 {
+		t.Fatalf("FIFO bypass by %d", got)
+	}
+	releaseWaiters <- struct{}{}
+	if got := <-order; got != 1 {
+		t.Fatalf("FIFO second %d", got)
+	}
+	releaseWaiters <- struct{}{}
+	wg.Wait()
+	waitMaxAdmission(t, g, 0, 0)
+}
+
+func TestWhiteZiaMaxAdmissionBoundedPendingAndCancel(t *testing.T) {
+	g := newCottenMaxAdmission(1)
+	release, _, _ := g.acquire(context.Background())
+	defer release()
+	var stops []context.CancelFunc
+	var wg sync.WaitGroup
+	for i := 0; i < cottenMaxLocalPendingLimit; i++ {
+		ctx, cancel := context.WithCancel(context.Background())
+		stops = append(stops, cancel)
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			done, _, err := g.acquire(ctx)
+			if done != nil {
+				done()
+			}
+			if !errors.Is(err, context.Canceled) {
+				t.Errorf("cancelled waiter: %v", err)
+			}
+		}()
+		waitMaxAdmission(t, g, 1, i+1)
+	}
+	if done, _, err := g.acquire(context.Background()); !errors.Is(err, errCottenMaxQueueFull) || done != nil {
+		t.Fatalf("65th pending was not refused: %v", err)
+	}
+	for _, stop := range stops {
+		stop()
+	}
+	wg.Wait()
+	waitMaxAdmission(t, g, 1, 0)
+	release()
+	waitMaxAdmission(t, g, 0, 0)
+}
+
+func TestWhiteZiaMaxAdmissionIdleIsRetainedButWaitIsBounded(t *testing.T) {
+	g := newCottenMaxAdmission(24)
+	var releases []func()
+	for range 24 {
+		release, _, err := g.acquire(context.Background())
+		if err != nil {
+			t.Fatal(err)
+		}
+		releases = append(releases, release)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if done, queued, err := g.acquire(ctx); !queued || !errors.Is(err, context.DeadlineExceeded) || done != nil {
+		t.Fatalf("idle queue deadline: %v", err)
+	}
+	waitMaxAdmission(t, g, 24, 0)
+	for _, release := range releases {
+		release()
+	}
+	waitMaxAdmission(t, g, 0, 0)
+}
+
+func TestWhiteZiaMaxAdmissionCancellationGrantRace(t *testing.T) {
+	for range 300 {
+		g := newCottenMaxAdmission(1)
+		release, _, _ := g.acquire(context.Background())
+		ctx, cancel := context.WithCancel(context.Background())
+		done := make(chan struct{})
+		go func() {
+			defer close(done)
+			next, _, err := g.acquire(ctx)
+			if err == nil {
+				next()
+				next()
+			}
+		}()
+		waitMaxAdmission(t, g, 1, 1)
+		var wg sync.WaitGroup
+		wg.Add(2)
+		go func() { defer wg.Done(); release() }()
+		go func() { defer wg.Done(); cancel() }()
+		wg.Wait()
+		<-done
+		waitMaxAdmission(t, g, 0, 0)
+	}
+}
+
+func TestWhiteZiaMaxAdmissionRespectsLowerConfiguredCap(t *testing.T) {
+	for _, limit := range []int{1, 8, 24, 32, 512, 0} {
+		g := newCottenMaxAdmission(limit)
+		want := limit
+		if want <= 0 || want > 24 {
+			want = 24
+		}
+		if g.limit != want {
+			t.Fatalf("limit=%d got %d", limit, g.limit)
+		}
+	}
+}
+
+func TestWhiteZiaMaxAdmissionQueuedPeerEOFAndPipelinedBytes(t *testing.T) {
+	if runtime.GOOS == "windows" {
+		t.Skip("queued peer EOF uses the Android/Linux/macOS Unix socket path")
+	}
+	listener, err := net.Listen("tcp", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer listener.Close()
+	peer, err := net.Dial("tcp", listener.Addr().String())
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer peer.Close()
+	local, err := listener.Accept()
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer local.Close()
+	if _, err = peer.Write([]byte("pipelined")); err != nil {
+		t.Fatal(err)
+	}
+	if cottenMaxLocalPeerClosed(local) {
+		t.Fatal("pipelined data mistaken for EOF")
+	}
+	var prefix [9]byte
+	local.SetReadDeadline(time.Now().Add(time.Second))
+	if n, err := local.Read(prefix[:]); err != nil || string(prefix[:n]) != "pipelined" {
+		t.Fatalf("peek consumed data: %d %v %q", n, err, prefix[:n])
+	}
+	local.SetReadDeadline(time.Time{})
+	g := newCottenMaxAdmission(1)
+	release, _, _ := g.acquire(context.Background())
+	defer release()
+	finished := make(chan error, 1)
+	go func() {
+		done, _, err := g.acquireWatching(context.Background(), func() bool { return cottenMaxLocalPeerClosed(local) })
+		if done != nil {
+			done()
+		}
+		finished <- err
+	}()
+	waitMaxAdmission(t, g, 1, 1)
+	peer.Close()
+	select {
+	case err := <-finished:
+		if !errors.Is(err, net.ErrClosed) {
+			t.Fatalf("queued EOF: %v", err)
+		}
+	case <-time.After(time.Second):
+		t.Fatal("queued disconnected peer retained its slot")
+	}
+	waitMaxAdmission(t, g, 1, 0)
+}
+
+func TestWhiteZiaMaxHealthReserveRespectsTotalConfiguredCap(t *testing.T) {
+	for _, tc := range []struct {
+		configured, total, regular, health int
+		shared                             bool
+	}{
+		{512, 28, 24, 4, false}, {28, 28, 24, 4, false}, {27, 27, 23, 4, false}, {24, 24, 20, 4, false}, {8, 8, 4, 4, false}, {4, 4, 2, 2, false}, {2, 2, 1, 1, false}, {1, 1, 1, 1, true}, {0, 28, 24, 4, false},
+	} {
+		regular, health, total := newCottenMaxAdmissions(tc.configured)
+		if total != tc.total || regular.limit != tc.regular || health.limit != tc.health || (regular == health) != tc.shared {
+			t.Fatalf("configuration %d allocated %d + %d total%d shared%t", tc.configured, regular.limit, health.limit, total, regular == health)
+		}
+	}
+	regular, health, total := newCottenMaxAdmissions(512)
+	var releases []func()
+	defer func() {
+		for _, release := range releases {
+			release()
+		}
+	}()
+	for range regular.limit {
+		done, _, err := regular.acquire(context.Background())
+		if err != nil {
+			t.Fatal(err)
+		}
+		releases = append(releases, done)
+	}
+	for range health.limit {
+		done, queued, err := health.acquire(context.Background())
+		if err != nil || queued {
+			t.Fatalf("idle regular streams starved health: %v", err)
+		}
+		releases = append(releases, done)
+	}
+	if a, _ := regular.state(); a+health.limit != total {
+		t.Fatal("total cap accounting changed")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if done, _, err := health.acquire(ctx); done != nil || !errors.Is(err, context.DeadlineExceeded) {
+		t.Fatalf("health reserve exceeded4: %v", err)
+	}
+}
+
+func TestWhiteZiaMaxHealthMarkerIsExactAndStripped(t *testing.T) {
+	for _, host := range []string{"connectivitycheck.gstatic.com", "www.google.com", "www.cloudflare.com", "ya.ru"} {
+		destination, health, err := cottenMaxDestination(host + cottenMaxHealthSuffix + ":443")
+		if err != nil || !health || destination != host+":443" {
+			t.Fatalf("marked health target: %q %t %v", destination, health, err)
+		}
+		destination, health, err = cottenMaxDestination(host + ":443")
+		if err != nil || health || destination != host+":443" {
+			t.Fatal("ordinary application flow gained health reserve")
+		}
+	}
+	for _, target := range []string{"evil.example.whitezia-health.invalid:443", "www.cloudflare.com.whitezia-health.invalid:80", "whitezia-health.invalid:443", "www.google.com.evil.whitezia-health.invalid:443"} {
+		if _, _, err := cottenMaxDestination(target); err == nil {
+			t.Fatalf("untrusted marker was not locally refused: %s", target)
+		}
+	}
+}
