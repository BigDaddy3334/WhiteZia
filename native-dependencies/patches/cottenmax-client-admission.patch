@@ -0,0 +1,30 @@
+package client
+
+// WhiteZia local SOCKS marker: it is stripped before authenticated Max dialing.
+// An ordinary application connection to one of these sites keeps normal
+// admission unless it explicitly uses this local marker. It is not a new
+// remote protocol or credential and grants no access to arbitrary targets.
+import (
+	"errors"
+	"net"
+	"strings"
+)
+
+const cottenMaxHealthSuffix = ".whitezia-health.invalid"
+
+func cottenMaxDestination(target string) (string, bool, error) {
+	host, port, err := net.SplitHostPort(target)
+	if err != nil {
+		return "", false, err
+	}
+	normalized := strings.ToLower(strings.TrimSuffix(host, "."))
+	if normalized != "whitezia-health.invalid" && !strings.HasSuffix(normalized, cottenMaxHealthSuffix) {
+		return target, false, nil
+	}
+	realHost := strings.TrimSuffix(normalized, cottenMaxHealthSuffix)
+	allowed := realHost == "connectivitycheck.gstatic.com" || realHost == "www.google.com" || realHost == "www.cloudflare.com" || realHost == "ya.ru"
+	if port != "443" || !allowed {
+		return "", false, errors.New("cottenmax: invalid local health target")
+	}
+	return net.JoinHostPort(realHost, port), true, nil
+}
