@@ -0,0 +1,30 @@
+//go:build unix
+
+package client
+
+// WhiteZia: queued TCP peers can cancel without consuming pipelined data.
+import (
+	"errors"
+	"net"
+	"syscall"
+
+	"golang.org/x/sys/unix"
+)
+
+func cottenMaxLocalPeerClosed(conn net.Conn) bool {
+	socket, ok := conn.(syscall.Conn)
+	if !ok {
+		return false
+	}
+	raw, err := socket.SyscallConn()
+	if err != nil {
+		return errors.Is(err, net.ErrClosed)
+	}
+	closed := false
+	err = raw.Control(func(fd uintptr) {
+		var peek [1]byte
+		n, _, readErr := unix.Recvfrom(int(fd), peek[:], unix.MSG_PEEK|unix.MSG_DONTWAIT)
+		closed = (readErr == nil && n == 0) || readErr == unix.ECONNRESET || readErr == unix.ENOTCONN || readErr == unix.EBADF
+	})
+	return closed || errors.Is(err, net.ErrClosed)
+}
